# Supabase
NEXT_PUBLIC_SUPABASE_URL=votre_url_supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_clé_anon_supabase

# Groq API (LLM + Embeddings)
GROQ_API_KEY=votre_clé_groq

# VAPID Keys pour Push Notifications
# Générer avec: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=votre_clé_publique_vapid
VAPID_PRIVATE_KEY=votre_clé_privée_vapid

# Supabase Edge Function (streak-reminder)
# Générer avec: openssl rand -base64 32
STREAK_REMINDER_SECRET=votre_clé_secrète_streak_reminder

# Métriques & Admin
METRICS_CRON_SECRET=votre_clé_secrète_cron

# Stripe (Optionnel - si facturation activée)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PARTIAL=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL (pour redirections Stripe)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com
